{
  "name": "nestjs-best-practices-scripts",
  "version": "1.0.0",
  "type": "module",
  "description": "Build scripts for NestJS Best Practices skillset",
  "scripts": {
    "build": "npx ts-node build-agents.ts",
    "build:watch": "npx nodemon --watch ../skills/nestjs-best-practices/rules --ext md --exec 'npx ts-node build-agents.ts'",
    "check:tokens": "node check-tokens.mjs",
    "test": "node --test ../skills/nestjs-learn/scripts/learn.test.mjs ../skills/nestjs-modular-monolith/scripts/modular-monolith.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dependency-cruiser": "^18.7.0",
    "js-tiktoken": "1.0.21",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
